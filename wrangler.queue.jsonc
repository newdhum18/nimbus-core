{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbus-core-queue",
  "main": "queue-consumer.js",
  "compatibility_date": "2025-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nimbus-db",
      "database_id": "ab619b87-8888-4eea-a632-304af715c786"
    }
  ],
  "limits": {
    "cpu_ms": 30000,
    "subrequests": 1000
  },
  "queues": {
    "consumers": [
      {
        "queue": "nimbus-autoscan-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}