{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbus-core-v36-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-11",
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nimbus-core-v36-db",
      "database_id": "bfe40290-c3bc-45c1-b91d-9af58baf9738",
      "migrations_dir": "src/db/migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "nimbus-core-v36-queue"
      }
    ],

    "consumers": [
      {
        "queue": "nimbus-core-v36-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 30,
        "max_concurrency": 1
      }
    ]
  },

  "triggers": { "crons": ["*/1 * * * *"] },

  "observability": {
    "enabled": true
  }
}
